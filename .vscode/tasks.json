{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "close": false
      }
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "npm: preview",
      "type": "npm",
      "script": "preview",
      "problemMatcher": []
    },
    {
      "label": "build + preview",
      "dependsOn": ["npm: build", "npm: preview"],
      "dependsOrder": "sequence",
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "close": false
      }
    },
    {
      "label": "npm: check",
      "type": "npm",
      "script": "check",
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "close": false
      }
    },
    {
      "label": "git: diff --staged > .user_files",
      "type": "shell",
      "command": "(echo %date% %time% & git diff --staged) > .temp/diff.patch",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "close": false
      }
    },
    {
      "type": "npm",
      "script": "archive",
      "problemMatcher": [],
      "label": "npm: archive",
      "detail": "node scripts/run_git_archive.js"
    },
    {
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-compact"],
      "label": "npm: lint",
      "detail": "eslint ."
    },
    {
      "label": "TaskFlow: Start Vite",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://localhost:5173/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "TaskFlow: Stop Vite",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "$connections = Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue; foreach ($connection in $connections) { $processId = $connection.OwningProcess; $process = Get-CimInstance Win32_Process -Filter \"ProcessId=$processId\"; if ($process.CommandLine -match 'vite') { Stop-Process -Id $processId -Force } }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    }
  ]
}
